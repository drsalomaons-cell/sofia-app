# SOFIA — variáveis de ambiente
# Copie para .env e ajuste os valores

# ── Local (desenvolvimento) ──
# Para testar no celular físico, troque localhost pelo IP do computador na mesma rede Wi-Fi.
API_URL_LOCAL=http://192.168.0.X:3000
SOCKET_URL_LOCAL=http://192.168.0.X:3000
PORT=3000
PUBLIC_URL=http://localhost:3000

# ── Produção ──
API_URL=https://sofia-app-yhzb.onrender.com
SOCKET_URL=https://sofia-app-yhzb.onrender.com

# ── PostgreSQL / Supabase ──
# DATABASE_URL=postgresql://user:pass@host:5432/sofia
# SUPABASE_DB_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# PGSSL=false

# ── PagBank ──
PAGBANK_SANDBOX=true
PAGBANK_AMBIENTE=sandbox
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_SECRET=

# ── ZEGO (áudio/vídeo) ──
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# ── Admin ──
ADMIN_CENTRAL_EMAIL=admin@sofia.app
ADMIN_CENTRAL_PASSWORD=CHANGE_ME_MIN_12_CHARS
SOFIA_CLIENT_TOKEN=sofia-app-v1
BRANDING_PROTECTION_KEY=SOFIA_BRANDING_V1