# SOFIA — variáveis de ambiente
# Copie para .env e ajuste os valores

# ── Local (desenvolvimento) ──
API_URL_LOCAL=http://localhost:3000
SOCKET_URL_LOCAL=http://localhost:3000
PORT=3000
PUBLIC_URL=http://localhost:3000

# ── Produção ──
API_URL=https://api.sofia.com.br
SOCKET_URL=https://socket.sofia.com.br

# ── PostgreSQL / Supabase ──
# DATABASE_URL=postgresql://user:pass@host:5432/sofia
# SUPABASE_DB_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# PGSSL=false

# ── PagBank ──
PAGBANK_SANDBOX=true
PAGBANK_AMBIENTE=sandbox
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_SECRET=

# ── ZEGO (áudio/vídeo) ──
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# ── Admin ──
ADMIN_CENTRAL_EMAIL=admin@sofia.app
ADMIN_CENTRAL_PASSWORD=Sofia@2026
SOFIA_CLIENT_TOKEN=sofia-app-v1
BRANDING_PROTECTION_KEY=SOFIA_BRANDING_V1
